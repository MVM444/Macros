# -*- coding: utf-8 -*-
# Icon: GameEngineExportLoader.svg
# GameEngineExportLoader Macro
# Description: Reload and activate GameEngineExportWB from this Macros repo.
# Notes: Uses ElectricCR-like hot-reload flow (purge modules + re-register workbench).
# Version: 2026-03-11

import importlib
import os
import sys

import FreeCAD as App
import FreeCADGui as Gui

LOG_PREFIX = "[GAMEEXPORT] "
WB_CANDIDATES = ("GameEngineExportWorkbench", "Game Engine Export WB", "GameEngineExportWB")
MODULE_PREFIXES = ("GameEngineExportWB", "Mod.GameEngineExportWB")
MODULE_CANDIDATES = ("GameEngineExportWB.InitGui", "Mod.GameEngineExportWB.InitGui")


def log_info(message):
    App.Console.PrintMessage(LOG_PREFIX + str(message) + "\n")


def log_error(message):
    App.Console.PrintError(LOG_PREFIX + str(message) + "\n")


def ensure_repo_on_path(repo_root):
    repo_root = os.path.normpath(os.path.abspath(repo_root))
    if repo_root not in sys.path:
        sys.path.insert(0, repo_root)
        log_info("Added repo path: " + repo_root)


def candidate_repo_roots():
    here = os.path.dirname(__file__)
    roots = []
    for root in (os.path.join(here, "Macros-de-Freecad"), here):
        root = os.path.normpath(os.path.abspath(root))
        if os.path.isdir(root) and root not in roots:
            roots.append(root)
    return roots


def purge_modules():
    removed = 0
    for name in list(sys.modules.keys()):
        if any(name == prefix or name.startswith(prefix + ".") for prefix in MODULE_PREFIXES):
            sys.modules.pop(name, None)
            removed += 1
    log_info("Purged modules: " + str(removed))


def remove_old_workbench():
    try:
        workbenches = dict(getattr(Gui, "listWorkbenches", lambda: {})() or {})
    except Exception:
        workbenches = {}

    if not hasattr(Gui, "removeWorkbench"):
        return

    # Some FreeCAD builds refuse removal while the target WB is active.
    try:
        Gui.activateWorkbench("StartWorkbench")
    except Exception:
        pass

    names_to_remove = set(WB_CANDIDATES)
    for existing_name in workbenches.keys():
        if "gameengineexport" in str(existing_name).lower():
            names_to_remove.add(existing_name)

    for wb_name in names_to_remove:
        if wb_name in workbenches:
            try:
                Gui.removeWorkbench(wb_name)
                log_info("Removed previous workbench: " + wb_name)
            except Exception as exc:
                log_error("Could not remove workbench " + wb_name + ": " + str(exc))


def activate_workbench():
    last_error = None
    for wb_name in WB_CANDIDATES:
        try:
            Gui.activateWorkbench(wb_name)
            log_info("Activated workbench: " + wb_name)
            return
        except Exception as exc:
            last_error = exc
    if last_error:
        raise last_error


def import_workbench_initgui():
    last_error = None
    for module_name in MODULE_CANDIDATES:
        try:
            module = importlib.import_module(module_name)
            importlib.reload(module)
            log_info("Loaded InitGui from: " + str(getattr(module, "__file__", "unknown")))
            return module
        except Exception as exc:
            last_error = exc
    if last_error:
        raise last_error


def main():
    for repo_root in candidate_repo_roots():
        ensure_repo_on_path(repo_root)
    purge_modules()
    importlib.invalidate_caches()
    remove_old_workbench()

    import_workbench_initgui()
    activate_workbench()
    log_info("Workbench reloaded successfully")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        log_error("Failed to load workbench: " + str(exc))
        raise
