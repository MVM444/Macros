    layout_config.addStretch(1)

    tabs_principal.addTab(tab_config, "Datos y config")

    def actualizar_estado_controles(en_progreso):
        estado["consulta_en_progreso"] = bool(en_progreso)
        boton_enviar.setEnabled(not en_progreso)
        boton_nuevo.setEnabled(not en_progreso)
        boton_recargar.setEnabled(not en_progreso)
        boton_actualizar_modelos.setEnabled(not en_progreso)
        combo_proveedor.setEnabled(not en_progreso)
        combo_modelos.setEnabled(not en_progreso)
        entrada_api_base.setEnabled(not en_progreso and estado.get("proveedor_actual") == PROVEEDOR_NUBE)
        entrada_api_key.setEnabled(not en_progreso and estado.get("proveedor_actual") == PROVEEDOR_NUBE)

    def actualizar_texto_endpoint():
        proveedor = estado.get("proveedor_actual", PROVEEDOR_OLLAMA)
        if proveedor == PROVEEDOR_NUBE:
            base = normalizar_api_base_nube(entrada_api_base.text())
            endpoint_activo = base + NUBE_RUTA_CHAT
            api_key_ok = bool(obtener_api_key_nube(entrada_api_key.text()))
            etiqueta_endpoint.setText(
                "Proveedor: nube | Endpoint chat: {} | API key detectada: {} | Timeout lectura default: {}s".format(
                    endpoint_activo,
                    "si" if api_key_ok else "no",
                    TIMEOUT_LECTURA_SEGUNDOS,
                )
            )
            return

        etiqueta_endpoint.setText(
            "Proveedor: local | Endpoint: {} | Timeout lectura default: {}s".format(
                URL_OLLAMA_GENERATE,
                TIMEOUT_LECTURA_SEGUNDOS,
            )
        )

    def actualizar_visibilidad_nube():
        proveedor = combo_proveedor.currentText().strip() or PROVEEDOR_OLLAMA
        estado["proveedor_actual"] = proveedor
        mostrar_nube = (proveedor == PROVEEDOR_NUBE)
        etiqueta_api_base.setVisible(mostrar_nube)
        entrada_api_base.setVisible(mostrar_nube)
        etiqueta_api_key.setVisible(mostrar_nube)
        entrada_api_key.setVisible(mostrar_nube)
        actualizar_estado_controles(estado["consulta_en_progreso"])
        actualizar_texto_endpoint()

    def actualizar_modelos_disponibles():
        proveedor = combo_proveedor.currentText().strip() or PROVEEDOR_OLLAMA
        estado["proveedor_actual"] = proveedor
        estado["api_base_nube"] = normalizar_api_base_nube(entrada_api_base.text())
        actualizar_visibilidad_nube()

        if proveedor == PROVEEDOR_NUBE:
            modelo_default = MODELO_NUBE_DEFAULT
        else:
            modelo_default = MODELO_OLLAMA

        modelo_preferido = estado.get("modelo_actual") or modelo_default
        modelos, error_modelos = obtener_modelos_disponibles(
            proveedor=proveedor,
            api_base_nube=estado["api_base_nube"],
            api_key_nube=entrada_api_key.text(),
        )

        combo_modelos.blockSignals(True)
        combo_modelos.clear()
        for nombre_modelo in modelos:
            combo_modelos.addItem(nombre_modelo)

        # Permite usar un modelo escrito manualmente aunque no salga en /api/tags.
        if modelo_preferido and combo_modelos.findText(modelo_preferido) < 0:
            combo_modelos.insertItem(0, modelo_preferido)

        indice = combo_modelos.findText(modelo_preferido)
        if indice < 0:
            indice = combo_modelos.findText(modelo_default)
        if indice < 0 and combo_modelos.count() > 0:
            indice = 0
        if indice >= 0:
            combo_modelos.setCurrentIndex(indice)
        combo_modelos.blockSignals(False)

        texto_actual = combo_modelos.currentText().strip()
        estado["modelo_actual"] = texto_actual or modelo_default

        if error_modelos:
            log_warn(error_modelos)
            etiqueta_estado.setText("No se pudo actualizar modelos. Activo: {}".format(estado["modelo_actual"]))
        else:
            etiqueta_estado.setText(
                "Modelos cargados ({}) activo: {}".format(
                    proveedor,
                    estado["modelo_actual"],
                )
            )

    def al_cambiar_modelo(_indice):
        texto_actual = combo_modelos.currentText().strip()
        if texto_actual:
            estado["modelo_actual"] = texto_actual
            etiqueta_estado.setText("Modelo activo: {}".format(estado["modelo_actual"]))

    def al_cambiar_proveedor(_indice):
        estado["proveedor_actual"] = combo_proveedor.currentText().strip() or PROVEEDOR_OLLAMA
        if estado["proveedor_actual"] == PROVEEDOR_NUBE and not entrada_api_base.text().strip():
            entrada_api_base.setText(NUBE_API_BASE_DEFAULT)
        actualizar_visibilidad_nube()
        actualizar_modelos_disponibles()

    def refrescar_vista_chat():
        tema_chat = colores_chat_desde_widget(panel_root)
        visor_chat.setHtml(render_historial_html(estado["historial"], tema=tema_chat))
        barra = visor_chat.verticalScrollBar()
        if barra is not None:
            barra.setValue(barra.maximum())

    def guardar_historial_actual():
        try:
            guardar_historial(estado["ruta_historial"], estado["historial"])
            log_info("Historial guardado en: {}".format(estado["ruta_historial"]))
        except Exception as exc:
            log_warn("No se pudo guardar historial: {}".format(exc))

    def cargar_historial_actual():
        estado["ruta_historial"] = obtener_ruta_historial_documento()
        estado["historial"] = cargar_historial(estado["ruta_historial"])

        nombre_doc = obtener_nombre_documento_activo() or "[sin documento]"
        ruta_doc = obtener_ruta_documento_activo() or "[documento sin guardar]"
        etiqueta_doc.setText("Documento activo: {} | {}".format(nombre_doc, ruta_doc))
        etiqueta_historial.setText("Historial: {}".format(estado["ruta_historial"]))
        etiqueta_estado.setText(
            "Historial cargado: {} mensajes.".format(len(estado["historial"]))
        )
        refrescar_vista_chat()

    def construir_contexto_extra():
        partes = []
        max_lineas = int(spin_lineas.value())

        if chk_incluir_informe.isChecked():
            texto_informe = leer_vista_informe(max_lineas)
            if texto_informe:
                partes.append("=== REPORT VIEW (ultimas lineas) ===\n{}".format(texto_informe))
            else:
                partes.append("=== REPORT VIEW ===\n[No disponible o vacio]")

        if chk_incluir_consola.isChecked():
            texto_consola = leer_consola_python(max_lineas)
            if texto_consola:
                partes.append("=== PYTHON CONSOLE (ultimas lineas) ===\n{}".format(texto_consola))
            else:
                partes.append("=== PYTHON CONSOLE ===\n[No disponible o vacio]")

        return "\n\n".join(partes).strip()

    def enviar_consulta():
        if estado["consulta_en_progreso"]:
            etiqueta_estado.setText("Ya hay una consulta en progreso.")
            return

        prompt_usuario = entrada_prompt.toPlainText().strip()
        if not prompt_usuario:
            etiqueta_estado.setText("Escribe un mensaje antes de enviar.")
            return

        estado["historial"].append(crear_mensaje("user", prompt_usuario))
        entrada_prompt.clear()
        refrescar_vista_chat()
        guardar_historial_actual()

        historial_sin_ultimo = estado["historial"][:-1]
        contexto_extra = construir_contexto_extra()
        proveedor_actual = combo_proveedor.currentText().strip() or PROVEEDOR_OLLAMA
        modelo_actual = combo_modelos.currentText().strip() or estado.get("modelo_actual") or MODELO_OLLAMA
        api_base_nube = normalizar_api_base_nube(entrada_api_base.text())
        api_key_nube = entrada_api_key.text().strip()
        estado["proveedor_actual"] = proveedor_actual
        estado["modelo_actual"] = modelo_actual
        estado["api_base_nube"] = api_base_nube
        timeout_lectura_actual = int(spin_timeout.value())

        def cerrar_consulta():
            try:
                QtWidgets.QApplication.restoreOverrideCursor()
            except Exception:
                pass
            actualizar_estado_controles(False)
            estado["thread_consulta"] = None
            estado["worker_consulta"] = None

        def al_exito(texto_respuesta, datos_crudos):
            if not texto_respuesta:
                texto_respuesta = "[Respuesta vacia]"
            estado["historial"].append(crear_mensaje("assistant", texto_respuesta))
            refrescar_vista_chat()
            guardar_historial_actual()
            etiqueta_estado.setText(
                "Respuesta recibida ({} / {}).".format(
                    estado.get("proveedor_actual", PROVEEDOR_OLLAMA),
                    estado.get("modelo_actual", MODELO_OLLAMA),
                )
            )
            try:
                log_info("Campos recibidos: {}".format(", ".join(sorted(datos_crudos.keys()))))
            except Exception:
                pass

        def al_error(mensaje, detalle):
            texto_error = "La consulta fallo: {}".format(mensaje)
            estado["historial"].append(crear_mensaje("assistant", texto_error))
            refrescar_vista_chat()
            guardar_historial_actual()
            mostrar_error(None, mensaje, detalle)
            etiqueta_estado.setText("Error en consulta.")

        try:
            actualizar_estado_controles(True)
            if timeout_lectura_actual <= 0:
                etiqueta_estado.setText(
                    "Consultando {} / '{}' (sin timeout lectura)...".format(
                        proveedor_actual,
                        modelo_actual,
                    )
                )
            else:
                etiqueta_estado.setText(
                    "Consultando {} / '{}' (timeout lectura={}s)...".format(
                        proveedor_actual,
                        modelo_actual,
                        timeout_lectura_actual,
                    )
                )
            QtWidgets.QApplication.setOverrideCursor(QtCore.Qt.WaitCursor)
            QtWidgets.QApplication.processEvents()

            hilo = QtCore.QThread()
            worker = ConsultaOllamaWorker(
                proveedor_actual,
                prompt_usuario,
                historial_sin_ultimo,
                contexto_extra,
                modelo_actual,
                api_base_nube,
                api_key_nube,
                TIMEOUT_CONEXION_SEGUNDOS,
                timeout_lectura_actual,
            )
            worker.moveToThread(hilo)

            hilo.started.connect(worker.ejecutar)
            worker.finalizado_ok.connect(al_exito)
            worker.finalizado_error.connect(al_error)
            worker.finalizado_ok.connect(hilo.quit)
            worker.finalizado_error.connect(hilo.quit)
            worker.finalizado_ok.connect(worker.deleteLater)
            worker.finalizado_error.connect(worker.deleteLater)
            hilo.finished.connect(hilo.deleteLater)
            hilo.finished.connect(cerrar_consulta)

            estado["thread_consulta"] = hilo
            estado["worker_consulta"] = worker
            hilo.start()
        except Exception as exc:
            detalle = traceback.format_exc()
            texto_error = "No se pudo iniciar la consulta: {}".format(exc)
            estado["historial"].append(crear_mensaje("assistant", texto_error))
            refrescar_vista_chat()
            guardar_historial_actual()
            mostrar_error(None, str(exc), detalle)
            etiqueta_estado.setText("Error al iniciar consulta.")
            cerrar_consulta()

    def nuevo_chat():
        estado["historial"] = []
        refrescar_vista_chat()
        guardar_historial_actual()
        etiqueta_estado.setText("Chat reiniciado y guardado.")

    class EntradaFiltro(QtCore.QObject):
        def eventFilter(self, objeto, evento):
            try:
                if evento.type() == QtCore.QEvent.KeyPress:
                    if evento.key() in (QtCore.Qt.Key_Return, QtCore.Qt.Key_Enter):
                        if evento.modifiers() & QtCore.Qt.ShiftModifier:
                            return False
                        enviar_consulta()
                        return True
            except Exception:
                pass
            return False

    filtro = EntradaFiltro(panel_root)
    entrada_prompt.installEventFilter(filtro)

    boton_enviar.clicked.connect(enviar_consulta)
    boton_nuevo.clicked.connect(nuevo_chat)
    boton_recargar.clicked.connect(cargar_historial_actual)
    boton_actualizar_modelos.clicked.connect(actualizar_modelos_disponibles)
    combo_proveedor.currentIndexChanged.connect(al_cambiar_proveedor)
    combo_modelos.currentIndexChanged.connect(al_cambiar_modelo)
    if combo_modelos.lineEdit() is not None:
        combo_modelos.lineEdit().editingFinished.connect(lambda: al_cambiar_modelo(-1))
    entrada_api_base.editingFinished.connect(actualizar_texto_endpoint)
    entrada_api_key.editingFinished.connect(actualizar_texto_endpoint)

    actualizar_visibilidad_nube()
    actualizar_modelos_disponibles()
    cargar_historial_actual()
    entrada_prompt.setFocus()
    return panel


def ejecutar_macro():
    global VENTANA_OLLAMA

    log_info("Iniciando macro: {}".format(NOMBRE_MACRO))
    log_info("Documento activo: {}".format(obtener_nombre_documento_activo() or "[sin documento]"))
    log_info("Seleccion actual: {} objeto(s)".format(len(obtener_seleccion_actual())))

    try:
        cerrar_ventana_existente()

        if VENTANA_OLLAMA is not None:
            try:
                VENTANA_OLLAMA.close()
            except Exception:
                pass

        ventana_principal = Gui.getMainWindow()
        VENTANA_OLLAMA = construir_interfaz()
        try:
            VENTANA_OLLAMA.setWindowFlags(
                VENTANA_OLLAMA.windowFlags() | QtCore.Qt.Window
            )
        except Exception:
            pass
        VENTANA_OLLAMA.show()
        VENTANA_OLLAMA.raise_()
        VENTANA_OLLAMA.activateWindow()
        log_info("Ventana mostrada.")
    except Exception as exc:
        detalle = traceback.format_exc()
        log_error("No se pudo abrir la interfaz: {}".format(exc))
        log_error(detalle)


ejecutar_macro()
