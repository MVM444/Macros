def reload_module(module_name):
    try:
        if module_name in sys.modules:
            importlib.reload(sys.modules[module_name])
            log_info("Reloaded module: " + module_name)
        else:
            importlib.import_module(module_name)
            log_info("Imported module: " + module_name)
    except Exception as e:
        log_error("Error reloading module " + module_name + ": " + str(e))
        raise


def activate_workbench():
    last_error = None
    for wb_name in CANDIDATE_WORKBENCH_NAMES:
        try:
            FreeCADGui.activateWorkbench(wb_name)
            log_info("Activated workbench: " + wb_name)
            return
        except Exception as exc:
            last_error = exc
            log_info("Workbench activation attempt failed: " + wb_name)
    if last_error is not None:
        log_error("Error activating workbench: " + str(last_error))
        raise last_error
