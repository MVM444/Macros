_ICON_NAME = "GameEngineExportLoader.svg"

LOG_PREFIX = "[GAMEEXPORT] "
CANDIDATE_WORKBENCH_NAMES = (
    "GameEngineExportWorkbench",
    "GameEngineExportWB",
    "Game Engine Export WB",
)
MODULES_TO_RELOAD = (
    "Mod.GameEngineExportWB.commands.cmd_open_config",
    "Mod.GameEngineExportWB.commands.cmd_open_panel",
    "Mod.GameEngineExportWB.core.exporter_x3d",
    "Mod.GameEngineExportWB.core.gamestart",
    "Mod.GameEngineExportWB.core.lights",
    "Mod.GameEngineExportWB.core.persist",
    "Mod.GameEngineExportWB.ui.panel_config",
    "Mod.GameEngineExportWB.ui.panel_export",
    "Mod.GameEngineExportWB.Init",
    "Mod.GameEngineExportWB.InitGui",
)


def _resolve_icon_path(icon_name):
    base_dir = os.path.dirname(__file__)
    candidates = [
        os.path.join(base_dir, icon_name),
        os.path.join(base_dir, "iconos", icon_name),
        os.path.join(os.path.dirname(base_dir), "iconos", icon_name),
    ]
    try:
        pref = FreeCAD.ParamGet("User parameter:BaseApp/Preferences/Macro").GetString("MacroPath", "")
        if pref:
            sep = ";" if os.name == "nt" else ":"
            for entry in pref.split(sep):
                entry = entry.strip()
                if entry:
                    candidates.extend(
                        [
                            os.path.join(entry, icon_name),
                            os.path.join(entry, "iconos", icon_name),
                            os.path.join(entry, "icons", icon_name),
                            os.path.join(entry, "Resources", icon_name),
                            os.path.join(entry, "Resources", "iconos", icon_name),
                            os.path.join(entry, "Resources", "icons", icon_name),
                        ]
                    )
    except Exception:
        pass
    seen = set()
    for candidate in candidates:
        norm = os.path.normpath(os.path.abspath(candidate))
        if norm in seen:
            continue
        seen.add(norm)
        if os.path.exists(norm):
            return norm
    return ""


__Icon__ = _resolve_icon_path(_ICON_NAME)
__icon__ = __Icon__


def log_info(message):
    FreeCAD.Console.PrintMessage(LOG_PREFIX + str(message) + "\n")


def log_error(message):
    FreeCAD.Console.PrintError(LOG_PREFIX + str(message) + "\n")
