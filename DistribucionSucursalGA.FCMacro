AREA_M2_TO_MM2 = 1000000.0
DEFAULT_POP_SIZE = 96
DEFAULT_GENERATIONS = 140
DEFAULT_PROPOSALS = 4
DEFAULT_GA_RUNS = 4
DEFAULT_TEXT_SIZE_MM = 150
MIN_ROOM_GAP_MM = 100.0
TEXT_VERTICAL_CENTER_OFFSET_FACTOR = 0.35
DEFAULT_CLEAR_PREVIOUS = True
DEFAULT_REALISTIC_ZONING = True
DEFAULT_USE_DOC_FEATURES = True
CIRCULATION_KINDS = {"circulacion", "circulation", "pasillo", "pasillos", "corredor"}
ROLE_ALIASES = {
    "frente": {"frente", "fachada", "front"},
    "puerta": {"puerta", "acceso", "door", "entrada"},
    "salida": {"salida", "emergencia", "exit"},
    "fijo": {"fijo", "fija", "fixed", "obstacle", "obstaculo", "zona_fija"},
}
FIXED_PROP_KEYS = {"fija", "fijo", "fixed", "is_fixed", "isfixed", "es_fijo", "esfijo", "ga_fijo"}
ROLE_PROP_KEYS = {"rol", "role", "tipo_zona", "zone_role", "ga_role", "feature_role", "tipo_feature"}
SETTINGS_PATH = "User parameter:Plugins/DistribucionSucursalGA"
RESULT_GROUP_PREFIX = "GA_Sucursal_"
