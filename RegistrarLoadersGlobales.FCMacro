# -*- coding: utf-8 -*-
"""Register every active workbench loader in FreeCAD's global Macros toolbar."""

import importlib
import os
import sys

import FreeCAD as App
import FreeCADGui as Gui


LOG_PREFIX = "[LOADERS] "


def _info(message):
    App.Console.PrintMessage(LOG_PREFIX + str(message) + "\n")


def _error(message):
    App.Console.PrintError(LOG_PREFIX + str(message) + "\n")


def _load_toolbar_helper(macro_dir):
    repo_dir = os.path.join(macro_dir, "Macros-de-Freecad")
    helper_file = os.path.join(repo_dir, "loader_toolbar.py")
    if not os.path.isfile(helper_file):
        raise RuntimeError("No encontre el modulo compartido: " + helper_file)
    if repo_dir not in sys.path:
        sys.path.insert(0, repo_dir)
    import loader_toolbar

    return importlib.reload(loader_toolbar)


def main():
    macro_dir = os.path.dirname(os.path.abspath(__file__))
    helper = _load_toolbar_helper(macro_dir)
    definitions = (
        (
            "ElectricCRLoader.FCMacro",
            "ElectricCRLoader.svg",
            "ElectricCR Loader",
            "Carga y recarga el workbench ElectricCR",
            "[ELECTRICCR-LOADER] ",
        ),
        (
            "FacilArquitecturaLoader.FCMacro",
            "FacilArquitecturaLoader.svg",
            "Facil Arquitectura Loader",
            "Carga y recarga el workbench Facil Arquitectura",
            "[FACILARQ-LOADER] ",
        ),
        (
            "GameEngineExportLoader.FCMacro",
            "GameEngineExportLoader.svg",
            "Game Engine Export Loader",
            "Carga y recarga el workbench Game Engine Export",
            "[GAMEEXPORT-LOADER] ",
        ),
        (
            "MEPWorkbenchCRLoader.FCMacro",
            "MEPWorkbenchCRLoader.svg",
            "MEP Workbench CR Loader",
            "Carga y recarga el workbench MEP Workbench CR",
            "[MEP-LOADER] ",
        ),
    )

    installed = 0
    for script_name, icon_name, menu_text, tooltip, prefix in definitions:
        macro_file = os.path.join(macro_dir, script_name)
        icon_file = os.path.join(macro_dir, icon_name)
        if not os.path.isfile(macro_file):
            _error("Loader omitido; no existe: " + script_name)
            continue
        if not os.path.isfile(icon_file):
            _error("Icono omitido; no existe: " + icon_name)
            continue
        helper.install_global_loader_toolbar(
            App,
            Gui,
            macro_file,
            icon_file,
            menu_text,
            tooltip,
            prefix,
        )
        installed += 1

    _info("Loaders registrados en la barra global Macros: {0}".format(installed))


main()
